@inherits LayoutComponentBase
@inject MusicProviders Providers
<a class="skip-link" href="#main-content">Ir para o conteúdo</a>
<div class="app-shell @(_showInspector ? "inspector-open" : "")">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Voxen, início">
            <span class="brand-symbol"><Icon Name="wave" Size="23" /></span>
            <span class="brand-text">Voxen<small>STUDIO</small></span>
        </a>
        <nav aria-label="Navegação principal">
            <NavLink href="/" Match="NavLinkMatch.All" title="Início"><Icon Name="home" /><span>Início</span></NavLink>
            <NavLink href="/search" title="Buscar"><Icon Name="search" /><span>Buscar</span></NavLink>
        </nav>
        <div class="library-section">
            <div class="sidebar-heading"><Icon Name="library" Size="16" /><span>Sua biblioteca</span></div>
            <p>Suas playlists e músicas favoritas terão um lugar aqui.</p>
            <span class="coming-soon">Em breve</span>
        </div>
        <div class="sidebar-note"><span class="source-dot"></span><span>YouTube disponível<small>Descubra seu próximo som.</small></span></div>
    </aside>
    <header class="topbar">
        <span class="workspace-title"><Icon Name="headphones" Size="17" /><span>Seu espaço para música</span></span>
        <div class="topbar-actions"><span class="connection-status"><span class="source-dot"></span>Áudio do YouTube</span>
            <button class="icon-button inspector-toggle" aria-label="Mostrar fila" aria-controls="queue-panel" aria-expanded="@_showInspector" @onclick="ToggleInspector"><Icon Name="queue" /></button>
        </div>
    </header>
    <main id="main-content" tabindex="-1"><div class="page-content">@Body</div></main>
    <aside id="queue-panel" class="right-inspector" aria-label="Fila de reprodução">
        <header class="inspector-heading"><Icon Name="wave" Size="18" /><h2>Agora tocando</h2><button class="icon-button inspector-close" aria-label="Fechar fila" @onclick="ToggleInspector"><Icon Name="close" Size="17" /></button></header>
        <QueuePanel />
        <div class="provider-section"><h3>Fontes de música</h3><div><span class="provider-name"><Icon Name="youtube" Size="17" />YouTube</span><span class="provider-state">Disponível</span></div><div><span class="provider-name"><Icon Name="cloud" Size="17" />SoundCloud</span><span class="coming-soon">@(Providers.SoundCloudAvailable ? "Configurado" : "Sem credenciais")</span></div></div>
    </aside>
    <PlayerDock />
</div>
@code {
    private bool _showInspector;
    private void ToggleInspector() => _showInspector = !_showInspector;
}
