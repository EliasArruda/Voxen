@inherits LayoutComponentBase
@inject MusicProviders Providers
<TrackAtmosphere />
<a class="skip-link" href="#main-content">Ir para o conteúdo</a>
<div class="app-shell @(_showInspector ? "inspector-open" : "")">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Voxen, início">
            <span class="brand-symbol"><Icon Name="wave" Size="23" /></span>
            <span class="brand-text">Voxen<small>STUDIO</small></span>
        </a>
        <nav aria-label="Navegação principal">
            <NavLink href="/" Match="NavLinkMatch.All" title="Início" aria-label="Início"><Icon Name="home" /><span>Início</span></NavLink>
            <NavLink href="/search" title="Buscar" aria-label="Buscar"><Icon Name="search" /><span>Buscar</span></NavLink>
            <NavLink href="/library" title="Biblioteca" aria-label="Biblioteca"><Icon Name="library" /><span>Biblioteca</span></NavLink>
        </nav>
        <div class="library-section" aria-label="Atalhos da biblioteca">
            <a class="library-shortcut" href="/library?view=favorites" title="Músicas favoritas" aria-label="Abrir músicas favoritas"><Icon Name="heart" Size="22" /></a>
            <a class="library-shortcut" href="/library#playlists-title" title="Suas playlists" aria-label="Abrir suas playlists"><Icon Name="music" Size="22" /></a>
        </div>
        <div class="sidebar-note" title="YouTube e SoundCloud disponíveis"><span class="source-dot"></span><span class="sr-only">YouTube e SoundCloud disponíveis</span></div>
    </aside>
    <header class="topbar">
        <a class="workspace-title" href="/" aria-label="Voxen, início">Voxen</a>
        <a class="global-search" href="/search"><Icon Name="search" Size="19" /><span>O que você quer ouvir?</span><kbd>Ctrl K</kbd></a>
        <div class="topbar-actions"><KeyboardShortcuts QueueToggle="ToggleInspector" DismissPanels="CloseInspector" /><span class="connection-status"><span class="source-dot"></span>Áudio nativo</span>
            <button class="icon-button inspector-toggle" aria-label="Mostrar fila" aria-controls="queue-panel" aria-expanded="@(_showInspector ? "true" : "false")" @onclick="ToggleInspector"><Icon Name="queue" /></button>
        </div>
    </header>
    <main id="main-content" tabindex="-1"><div class="page-content">@Body</div></main>
    <aside id="queue-panel" class="right-inspector" aria-label="Fila de reprodução">
        <header class="inspector-heading"><Icon Name="wave" Size="18" /><h2>Agora tocando</h2><button class="icon-button inspector-close" aria-label="Fechar fila" @onclick="ToggleInspector"><Icon Name="close" Size="17" /></button></header>
        <QueuePanel />
        <div class="provider-section"><h3>Fontes de música</h3><div><span class="provider-name"><Icon Name="youtube" Size="17" />YouTube</span><span class="provider-state">Disponível</span></div><div><span class="provider-name"><Icon Name="cloud" Size="17" />SoundCloud</span><span class="coming-soon">@(Providers.SoundCloudOfficial ? "API oficial" : "Integração pública")</span></div></div>
    </aside>
    <PlayerDock />
</div>
@code {
    private bool _showInspector;
    private void CloseInspector() => _showInspector = false;
    private void ToggleInspector() => _showInspector = !_showInspector;
}
