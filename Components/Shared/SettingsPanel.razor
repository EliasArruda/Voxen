@inject AppPreferences Preferences
@inject PlayerService Player
<section class="settings-panel" aria-labelledby="settings-title">
    <header class="settings-heading"><div><h1 id="settings-title">@T["Configurações"]</h1><p>@T["Seu idioma. Seu som. Seu ambiente."]</p></div></header>
    <section class="settings-section"><h2>@T["Idioma"]</h2><label for="app-language">@T["Idioma da aplicação"]</label><select id="app-language" value="@Preferences.Data.Language" @onchange="Language"><option value="pt-BR">Português (Brasil)</option><option value="en">English</option><option value="es">Español</option></select></section>
    <section class="settings-section"><h2>@T["Equalizador"]</h2><p>@T["Ajuste sete bandas de frequência e o balanço estéreo enquanto a música toca."]</p><div class="tone-presets" role="group" aria-label="@T["Presets de áudio"]">
        @foreach(var preset in Presets) { <button class="source-button @(Preferences.Data.Preset == preset.Id ? "active" : "")" aria-pressed="@(Preferences.Data.Preset == preset.Id ? "true" : "false")" @onclick="()=>Preset(preset.Id)">@T[preset.Label]</button> }
    </div>
    <div class="equalizer">
        @foreach(var band in Bands) { <div class="eq-band"><label for="@("eq-"+band.Id)">@T[band.Label]<small>@band.Frequency</small></label><input id="@("eq-"+band.Id)" type="range" min="-12" max="12" step="1" value="@Gain(band.Id)" @oninput="e=>GainChanged(band.Id,e)" /><output for="@("eq-"+band.Id)">@Gain(band.Id).ToString("+0;-0;0") dB</output></div> }
    </div>
    <div class="eq-band balance-band"><label for="eq-balance">@T["Balanço estéreo"]<small>@T["Esquerda / direita"]</small></label><input id="eq-balance" type="range" min="-1" max="1" step="0.05" value="@Preferences.Tone.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="BalanceChanged" /><output for="eq-balance">@(Preferences.Tone.Balance==0 ? T["Centro"] : (Preferences.Tone.Balance<0 ? "L " : "R ")+Math.Abs(Preferences.Tone.Balance*100).ToString("0")+"%")</output></div>
    <button class="text-button" @onclick="ResetTone">@T["Restaurar áudio original"]</button>
    <p class="settings-hint">@T["O equalizador reserva volume para evitar distorção nos boosts."]</p>
    </section>
    <section class="settings-section appearance-setting"><div><h2>@T["Cores da capa"]</h2><p>@T["Deixe cada música mudar a atmosfera do Voxen."]</p></div><button class="toggle-switch" aria-label="@T["Cores da capa"]" aria-pressed="@(Preferences.Data.CoverColors ? "true" : "false")" @onclick="()=>Preferences.CoverColors(!Preferences.Data.CoverColors)"><span></span></button></section>
    @if(Preferences.Error is not null) { <p role="alert">@T[Preferences.Error]</p> }
</section>
@code {
    private static readonly (string Id,string Label)[] Presets = [("flat","Original"),("bass","Bass boost"),("voice","Voz"),("bright","Brilho"),("rock","Rock"),("electronic","Eletrônica"),("acoustic","Acústico"),("soft","Suave")];
    private static readonly (string Id,string Label,string Frequency)[] Bands = [("sub","Subgraves","32 Hz"),("bass","Graves","100 Hz"),("lowmid","Corpo","300 Hz"),("mid","Médios","1 kHz"),("highmid","Presença","3 kHz"),("treble","Agudos","8 kHz"),("air","Ar e brilho","16 kHz")];
    private Task BalanceChanged(ChangeEventArgs e)=>GainChanged("balance",e);
    private Task ResetTone()=>Preset("flat");
    private void Language(ChangeEventArgs e)=>Preferences.Language(e.Value?.ToString()??"pt-BR");
    private async Task Preset(string id) { Preferences.Preset(id);await Player.ApplyToneAsync(); }
    private double Gain(string band)=>band switch { "bass"=>Preferences.Tone.Bass,"mid"=>Preferences.Tone.Mid,"sub"=>Preferences.Tone.SubBass,"lowmid"=>Preferences.Tone.LowMid,"highmid"=>Preferences.Tone.HighMid,"air"=>Preferences.Tone.Air,_=>Preferences.Tone.Treble };
    private async Task GainChanged(string band,ChangeEventArgs e) { if(!double.TryParse(e.Value?.ToString(),System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out var value))return;var tone=Preferences.Tone;Preferences.Equalizer(band switch { "bass"=>tone with {Bass=value},"mid"=>tone with {Mid=value},"sub"=>tone with {SubBass=value},"lowmid"=>tone with {LowMid=value},"highmid"=>tone with {HighMid=value},"air"=>tone with {Air=value},"balance"=>tone with {Balance=value},_=>tone with {Treble=value} });await Player.ApplyToneAsync(); }
}
