<footer class="player-dock" aria-label="Player, reprodução em breve">
    <div class="dock-track"><span class="dock-art"><Icon Name="music" Size="22" /></span><div><strong>Nenhuma música tocando</strong><small id="player-unavailable">Reprodução em breve</small></div></div>
    <div class="dock-transport">
        <div class="transport-buttons" aria-describedby="player-unavailable">
            <button class="icon-button" disabled aria-label="Aleatório, em breve"><Icon Name="shuffle" Size="17" /></button>
            <button class="icon-button" disabled aria-label="Faixa anterior, em breve"><Icon Name="previous" Size="18" /></button>
            <button class="play-button" disabled aria-label="Reproduzir, em breve"><Icon Name="play" Size="18" /></button>
            <button class="icon-button" disabled aria-label="Próxima faixa, em breve"><Icon Name="next" Size="18" /></button>
            <button class="icon-button" disabled aria-label="Repetir, em breve"><Icon Name="repeat" Size="17" /></button>
        </div>
        <div class="dock-timeline" aria-hidden="true"><span>0:00</span><span class="timeline-rail"></span><span>0:00</span></div>
    </div>
    <div class="dock-output" aria-hidden="true"><Icon Name="volume" Size="18" /><span class="volume-rail"></span><span>—</span></div>
</footer>
