@implements IDisposable
@inject LibraryService Library
@inject RecommendationService Recommendations
@inject QueueService Queue
@inject PlayerService Player
<section class="explore-landing" aria-label="@T["Descobertas musicais"]">
    <div class="explore-categories"><a href="/explore?q=new%20music"><Icon Name="music" />@T["Novos sons"]</a><a href="/explore?q=popular%20music"><Icon Name="wave" />@T["Mais ouvidas"]</a><a href="#genres"><Icon Name="compass" />@T["Momentos e gêneros"]</a></div>
    @if(_tracks.Count>0) { <MusicShelf Title="@T["Para descobrir"]" Tracks="_tracks" /> }
    else if(_loading) { <div class="section-heading"><h2>@T["Para descobrir"]</h2></div><div class="cover-shelf" aria-hidden="true">@for(var i=0;i<6;i++) { <div class="shelf-skeleton"></div> }</div><p class="inline-notice" role="status">@T["Encontrando novos sons…"]</p> }
    else { <p class="inline-notice" role="status">@T["Busque um artista ou escolha um gênero para começar."]</p> }
    <section id="genres" class="genre-section"><div class="section-heading"><h2>@T["Momentos e gêneros"]</h2></div><MusicMoods /></section>
    @if(References.Length>0) { <div class="section-heading"><h2>@T["Do seu repertório"]</h2></div><div class="music-moods">@foreach(var artist in References) { <a href="@("/explore?q="+Uri.EscapeDataString(artist))">@artist</a> }</div> }
</section>
@code {
    private IReadOnlyList<Track> _tracks=[];
    private bool _loading=true,_disposed;
    private readonly CancellationTokenSource _request=new(TimeSpan.FromSeconds(35));
    private string[] References => Library.History.Select(item=>item.Track.Artist).Concat(Library.Favorites.Select(track=>track.Artist)).Where(artist=>!string.IsNullOrWhiteSpace(artist)).Distinct(StringComparer.OrdinalIgnoreCase).Take(6).ToArray();
    protected override async Task OnInitializedAsync()
    {
        _tracks=Library.History.Select(entry=>entry.Track).Concat(Library.Favorites).DistinctBy(LibraryService.Key).Take(12).ToArray();
        try { var results=await Recommendations.DiscoverAsync(Player.CurrentTrack,Queue.Entries,12,_request.Token);if(!_disposed && results.Count>0)_tracks=results.Select(item=>item.Track).ToArray(); }
        catch(OperationCanceledException) { } catch(Exception) { }
        finally { _loading=false; }
    }
    public void Dispose() { _disposed=true;_request.Cancel();_request.Dispose(); }
}
