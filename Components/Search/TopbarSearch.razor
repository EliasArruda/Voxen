@implements IAsyncDisposable
@inject Func<SearchSession> CreateSession
@inject PlaybackCoordinator Playback
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
<div class="global-search topbar-search" @ref="_element">
    <Icon Name="search" Size="19" />
    <label class="sr-only" for="topbar-search">@T["Buscar músicas ou artistas"]</label>
    <input id="topbar-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="@(Visible ? "true" : "false")" aria-controls="topbar-suggestions" aria-activedescendant="@(_active >= 0 && Visible ? "topbar-option-"+_active : null)" placeholder="@T["O que você quer ouvir?"]" value="@_query" @oninput="Input" @onfocus="()=>_open=true" autocomplete="off" maxlength="200" />
    @if(Visible)
    {
        <div class="search-popover">
            <div id="topbar-suggestions" role="listbox" aria-label="@T["Sugestões de músicas"]">
            @for(var i=0;i<Suggestions.Count;i++)
            {
                var index=i;var track=Suggestions[index];
                <button id="@("topbar-option-"+index)" role="option" aria-selected="@(index==_active ? "true" : "false")" class="suggestion-option" @onclick="()=>Play(track)"><span class="suggestion-cover">@if(track.ThumbnailUrl.Length>0) { <img src="@track.ThumbnailUrl" alt="" referrerpolicy="no-referrer" /> } else { <Icon Name="music" /> }</span><span><strong>@track.Title</strong><small>@track.Artist</small></span><Icon Name="@(track.Source==TrackSource.YouTube ? "youtube" : "cloud")" Size="16" /></button>
            }
            </div>
            @if(_session.Status is SearchStatus.Waiting or SearchStatus.Loading && Suggestions.Count==0) { <p role="status">@T["Buscando…"]</p> }
            else if(_session.Status==SearchStatus.Error) { <p role="alert">@T[_session.ErrorMessage]</p> }
            else if(_session.Status==SearchStatus.Ready && Suggestions.Count==0) { <p role="status">@T["Nenhum resultado por aqui."]</p> }
            <a class="search-all" href="@("/explore?q="+Uri.EscapeDataString(_query))" @onclick="Close">@T["Ver todos os resultados"]<Icon Name="arrow" Size="16" /></a>
        </div>
    }
</div>
@code {
    private SearchSession _session=default!;
    private string _query="";
    private bool _open,_disposed;
    private int _active=-1;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TopbarSearch>? _reference;
    private IReadOnlyList<Track> Suggestions=>_session.Results.Take(4).ToArray();
    private bool Visible=>_open && _query.Trim().Length>=2;
    protected override void OnInitialized() { _session=CreateSession();_session.Changed+=Changed;Navigation.LocationChanged+=Navigated; }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if(firstRender) { _module=await JS.InvokeAsync<IJSObjectReference>("import","./Scripts/topbar-search.js");_reference=DotNetObjectReference.Create(this);await _module.InvokeVoidAsync("initialize",_element,_reference); } }
    private Task Input(ChangeEventArgs e) { _query=e.Value?.ToString()??"";_open=true;_active=-1;return _session.UpdateAsync(_query); }
    private void Changed() { if(!_disposed)_=InvokeAsync(()=>{_active=Math.Min(_active,Suggestions.Count-1);StateHasChanged();}); }
    private void Navigated(object? sender,Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { Close(); }
    private void Close() { _open=false;_active=-1;Changed(); }
    [JSInvokable] public Task Dismiss() { Close();return Task.CompletedTask; }
    [JSInvokable] public async Task SearchKey(string key)
    {
        if(key=="Escape") { Close();return; }
        if(key=="Enter") { if(_open && Suggestions.Count>0)await Play(Suggestions[Math.Clamp(_active,0,Suggestions.Count-1)]);else if(_query.Trim().Length>=2)Navigation.NavigateTo("/explore?q="+Uri.EscapeDataString(_query));return; }
        if(Suggestions.Count==0)return;
        _open=true;_active=key=="ArrowDown" ? (_active+1)%Suggestions.Count : (_active<0 ? Suggestions.Count-1 : (_active+Suggestions.Count-1)%Suggestions.Count);Changed();
    }
    private async Task Play(Track track) { Close();await Playback.PlayTrackAsync(track); }
    public async ValueTask DisposeAsync() { _disposed=true;_session.Changed-=Changed;Navigation.LocationChanged-=Navigated;_session.Dispose();if(_module is not null) { try { await _module.InvokeVoidAsync("dispose");await _module.DisposeAsync(); } catch(JSDisconnectedException) { } }_reference?.Dispose(); }
}
