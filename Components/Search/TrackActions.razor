@implements IDisposable
@inject LibraryService Library
@inject PlaybackCoordinator Playback
<div class="track-actions">
    <button class="icon-button @(Library.IsFavorite(Track) ? "selected-action" : "")" aria-label="@(Library.IsFavorite(Track) ? $"Desfavoritar {Track.Title}" : $"Favoritar {Track.Title}")" aria-pressed="@(Library.IsFavorite(Track) ? "true" : "false")" @onclick="Favorite"><Icon Name="heart" Size="16" /></button>
    <button class="icon-button @(Library.IsSaved(Track) ? "selected-action" : "")" aria-label="@(Library.IsSaved(Track) ? $"Remover {Track.Title} da biblioteca" : $"Salvar {Track.Title} na biblioteca")" aria-pressed="@(Library.IsSaved(Track) ? "true" : "false")" @onclick="Save"><Icon Name="bookmark" Size="16" /></button>
    <button class="row-add icon-button" aria-label="Adicionar @Track.Title à fila" @onclick="() => Playback.Add(Track)"><Icon Name="plus" Size="17" /></button>
</div>
@if (_error is not null) { <span class="action-error" role="alert">@_error</span> }
@code {
    [Parameter, EditorRequired] public Track Track { get; set; } = default!;
    protected override void OnInitialized() => Library.Changed += Refresh;
    private void Favorite() => Try(() => Library.ToggleFavorite(Track));
    private void Save() => Try(() => Library.ToggleSaved(Track));
    private void Try(Action action) { try { action(); _error = null; } catch (InvalidOperationException e) { _error = e.Message; } }
    private string? _error;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Library.Changed -= Refresh;
}
