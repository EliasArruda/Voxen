@page "/search"
@implements IDisposable
@inject Func<SearchSession> CreateSession
@inject MusicProviders Providers
@inject Microsoft.Extensions.Logging.ILogger<SearchSession> Logger
<div class="page-heading"><div><h1>Busca universal</h1><p class="page-description">Encontre músicas e artistas. Descubra seu próximo som.</p></div><span class="source-badge @(_source is null ? "all-sources" : _source == TrackSource.SoundCloud ? "soundcloud-badge" : "")"><Icon Name="@(_source is null ? "search" : _source == TrackSource.YouTube ? "youtube" : "cloud")" Size="14" />@SourceLabel</span></div>
<div class="source-selector" aria-label="Fonte da pesquisa"><button aria-pressed="@(_source is null ? "true" : "false")" @onclick="() => ChangeSource(null)"><Icon Name="search" Size="16" />Todas <span>YouTube + SoundCloud</span></button><button aria-pressed="@(_source == TrackSource.YouTube ? "true" : "false")" @onclick="() => ChangeSource(TrackSource.YouTube)"><Icon Name="youtube" Size="16" />YouTube</button><button aria-pressed="@(_source == TrackSource.SoundCloud ? "true" : "false")" @onclick="() => ChangeSource(TrackSource.SoundCloud)"><Icon Name="cloud" Size="16" />SoundCloud @if (!Providers.SoundCloudOfficial) { <span>Integração pública</span> }</button></div>
<SearchInput Value="@_input" ValueChanged="OnInput" />
<section class="search-results" aria-busy="@(Session.Status is SearchStatus.Waiting or SearchStatus.Loading ? "true" : "false")">
    @if (Session.Status != SearchStatus.Idle) { <div class="results-heading"><h2>Faixas encontradas</h2><span role="status" aria-live="polite">@StatusText</span></div> }
    @if (Session.Notice is not null) { <p class="inline-notice" role="status">@Session.Notice</p> }
    @if (Session.Status is SearchStatus.Loading or SearchStatus.Waiting && Session.Results.Count == 0)
    {
        <div class="skeleton-list" aria-hidden="true">
            @for (var i = 0; i < 5; i++)
            { <div class="skeleton-row"><span class="skeleton-art"></span><span class="skeleton-text"></span></div> }
        </div>
    }
    else if (Session.Status == SearchStatus.Error)
    {
        <div class="empty-state" role="alert"><h3>A busca encontrou um obstáculo.</h3><p>@Session.ErrorMessage</p><button class="secondary-button" @onclick="Retry">Tentar novamente</button></div>
    }
    else if (Session.Results.Count > 0)
    {
        <SearchHighlight Track="@Session.Results[0]" />
        <TrackResults Tracks="@Session.Results" />
    }
    else if (Session.Status == SearchStatus.Ready)
    {
        <div class="empty-state"><span class="empty-symbol"><Icon Name="search" Size="32" /></span><h3>Nenhum resultado por aqui.</h3><p>Tente outro título, nome de artista ou uma busca mais curta.</p></div>
    }
    else
    {
        <SearchIdeas />
    }
</section>
@code {
    [SupplyParameterFromQuery(Name = "q")] public string? InitialQuery { get; set; }
    private TrackSource? _source;
    private string SourceLabel => _source?.ToString() ?? "Todas as fontes";
    private async Task ChangeSource(TrackSource? source)
    {
        if (_source == source) return;
        Session.Changed -= OnChanged; Session.Dispose();
        _source = source; Session = new SearchSession(Providers.Search(source), Logger); Session.Changed += OnChanged;
        await Session.UpdateAsync(_input);
    }
    private string? _previousInitialQuery;
    private SearchSession Session = default!;
    private string _input = string.Empty;
    private bool _disposed;
    protected override void OnInitialized()
    {
        Session = CreateSession();
        Session.Changed += OnChanged;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (InitialQuery == _previousInitialQuery) return;
        _previousInitialQuery = InitialQuery;
        _input = (InitialQuery ?? string.Empty)[..Math.Min(InitialQuery?.Length ?? 0, 200)];
        await Session.UpdateAsync(_input);
    }
    private Task OnInput(string value)
    {
        _input = value;
        return Session.UpdateAsync(value);
    }
    private Task Retry() => Session.UpdateAsync(_input, retry: true);
    private void OnChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private string StatusText => Session.Status switch
    {
        SearchStatus.Waiting => "Aguardando digitação…",
        SearchStatus.Loading => Session.Results.Count > 0 ? $"{Session.Results.Count} resultados · buscando na outra fonte…" : "Buscando…",
        SearchStatus.Ready => $"{Session.Results.Count} resultados",
        _ => ""
    };
    public void Dispose()
    {
        _disposed = true;
        Session.Changed -= OnChanged;
        Session.Dispose();
    }
}
