@page "/"
@implements IDisposable
@inject RecommendationService Recommendations
@inject LibraryService Library
@inject PlayerService Player
@inject QueueService Queue
@inject PlaybackCoordinator Playback
<h1 class="sr-only">@T["Início"]</h1>
<MusicMoods />
<section class="quick-picks" aria-labelledby="quick-picks-title">
    <div class="section-heading"><h2 id="quick-picks-title">@T["Escolha a dedo"]</h2><button class="text-button" disabled="@_loading" @onclick="LoadRecommendations">@T["Atualizar descobertas"]</button></div>
    <p class="discovery-context">@(Library.History.Count > 0 ? T["Seu repertório e novos sons para acompanhar o dia."] : T["Ouça e favorite músicas. As próximas recomendações vão acompanhar seu gosto."])</p>
    @if(QuickPicks.Count > 0)
    {
        <ol class="quick-pick-grid">
        @foreach(var track in QuickPicks)
        {
            <li @key="LibraryService.Key(track)"><button class="quick-pick-play" disabled="@(!Player.Ready)" @onmouseenter="() => Player.PrepareAsync(track)" @onfocus="() => Player.PrepareAsync(track)" @onclick="() => Playback.PlayTrackAsync(track)" aria-label="@T.Format("Reproduzir {0}", track.Title)"><span class="quick-pick-art">@if(track.ThumbnailUrl.Length>0) { <img src="@track.ThumbnailUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> } else { <Icon Name="music" /> }</span><span><strong title="@track.Title">@track.Title</strong><small>@track.Artist</small></span></button></li>
        }
        </ol>
    }
    else if(_loading) { <div class="quick-pick-grid" aria-hidden="true">@for(var i=0;i<12;i++) { <div class="skeleton-row"><span class="skeleton-art"></span><span class="skeleton-text"></span></div> }</div> }
    @if(_loading) { <p class="inline-notice" role="status">@T["Encontrando novos sons…"]</p> }
    else if(_error is not null) { <p class="inline-notice" role="alert">@T[_error]</p><button class="secondary-button" @onclick="LoadRecommendations">@T["Tentar novamente"]</button> }
    else if(QuickPicks.Count==0) { <p>@T["Você já passou por esta seleção."]</p><a class="text-button" href="/explore">@T["Explorar"]</a> }
</section>
@if(_recommendations.Count>0) { <MusicShelf Title="@T["Para descobrir"]" Tracks="@_recommendations.Select(item=>item.Track).ToArray()" Link="/explore" /> }
@if(Library.History.Count>0) { <MusicShelf Title="@T["Ouvidas recentemente"]" Tracks="@Library.History.Select(entry=>entry.Track).DistinctBy(LibraryService.Key).Take(12).ToArray()" Link="/library" /> }
<section class="genre-section"><div class="section-heading"><h2>@T["Momentos e gêneros"]</h2></div><MusicMoods /></section>
@code {
    private IReadOnlyList<Track> QuickPicks => Library.History.Select(entry => entry.Track).Concat(Library.Favorites).Concat(_recommendations.Select(item => item.Track)).DistinctBy(LibraryService.Key).Take(12).ToArray();
    private IReadOnlyList<RecommendedTrack> _recommendations = [];
    private bool _loading, _disposed;
    private string? _error;
    private CancellationTokenSource? _request;
    protected override async Task OnInitializedAsync() { Library.Changed += Refresh; Player.Changed += Refresh; await LoadRecommendations(); }
    private async Task LoadRecommendations()
    {
        _request?.Cancel(); var request = new CancellationTokenSource(TimeSpan.FromSeconds(35)); _request = request;
        _loading = true; _error = null;
        try { var items = await Recommendations.DiscoverAsync(Player.CurrentTrack, Queue.Entries, 16, request.Token); if (!_disposed && _request == request) _recommendations = items; }
        catch (OperationCanceledException) { if (!_disposed && _request == request) _error = "A busca demorou demais. Tente novamente."; }
        catch (Exception) { if (!_disposed && _request == request) _error = "Verifique sua conexão e tente atualizar as descobertas."; }
        finally { if (_request == request) { _request = null; _loading = false; } request.Dispose(); }
    }
    private void Refresh() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { _disposed = true; _request?.Cancel(); Library.Changed -= Refresh; Player.Changed -= Refresh; }
}
